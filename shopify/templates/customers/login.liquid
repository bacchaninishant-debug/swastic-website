{% comment %}
  Shopify Template: customers/login.liquid
  Atelier Client Access for Swastic Exports House of Natural Gemstones
{% endcomment %}

<div class="account-page-wrapper">
  <div class="account-page-container">
    <nav class="account-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span class="breadcrumb-current">Client Sign In</span>
    </nav>

    <div class="auth-split-grid">
      <!-- Left: Client Sign In Form -->
      <div class="auth-card" id="customerLoginForm">
        <div class="auth-card-badge">
          <span>✦</span> ATELIER CLIENT ACCESS <span>✦</span>
        </div>
        <h1 class="auth-card-title">Sign In to Your Account</h1>
        <p class="auth-card-sub">
          Access your gemstone orders, certified digital GIA dossiers, private vault viewings, and bespoke acquisitions.
        </p>

        {% form 'customer_login' %}
          {{ form.errors | default_errors }}

          <div class="auth-form-group">
            <label class="auth-form-label" for="CustomerEmail">Email Address</label>
            <input 
              type="email" 
              name="customer[email]" 
              id="CustomerEmail" 
              class="auth-form-input" 
              autocomplete="email" 
              autocorrect="off" 
              autocapitalize="off" 
              placeholder="e.g. collector@swasticexports.com" 
              required
            >
          </div>

          {% if form.password_needed %}
            <div class="auth-form-group">
              <div class="auth-label-row">
                <label class="auth-form-label" for="CustomerPassword">Password</label>
                <a href="#recover" id="RecoverPassword" class="auth-text-link">Forgot Password?</a>
              </div>
              <input 
                type="password" 
                value="" 
                name="customer[password]" 
                id="CustomerPassword" 
                class="auth-form-input" 
                autocomplete="current-password" 
                placeholder="••••••••••••" 
                required
              >
            </div>
          {% endif %}

          <button type="submit" class="auth-submit-btn">SIGN IN TO ATELIER</button>
        {% endform %}

        <!-- Recover Password Form (Hidden by default) -->
        <div id="RecoverPasswordForm" style="display: none; margin-top: 30px; border-top: 1px solid #ebe5dc; padding-top: 25px;">
          <h2 style="font-family: 'Cormorant Garamond', serif; font-size: 26px; margin-bottom: 8px; color: #111;">Reset Client Password</h2>
          <p style="font-size: 13px; color: #666; margin-bottom: 20px;">We will send you an encrypted recovery link to regain atelier access.</p>
          
          {% form 'recover_customer_password' %}
            {{ form.errors | default_errors }}
            <div class="auth-form-group">
              <label class="auth-form-label" for="RecoverEmail">Registered Email</label>
              <input type="email" name="email" id="RecoverEmail" class="auth-form-input" placeholder="collector@swasticexports.com" required>
            </div>
            <button type="submit" class="auth-submit-btn">SEND RESET INSTRUCTIONS</button>
            <div style="text-align: center; margin-top: 15px;">
              <a href="#login" id="HideRecoverPasswordLink" class="auth-text-link">Return to Sign In</a>
            </div>
          {% endform %}
        </div>

        <div class="auth-card-footer">
          <p class="auth-footer-text">
            Don't have an Atelier Account yet?
            <a href="{{ routes.account_register_url }}" class="auth-accent-link">Request VIP Access</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Simple recovery form toggle for Shopify customer portal
  const recoverBtn = document.getElementById('RecoverPassword');
  const cancelBtn = document.getElementById('HideRecoverPasswordLink');
  const recoverForm = document.getElementById('RecoverPasswordForm');
  if (recoverBtn && recoverForm) {
    recoverBtn.addEventListener('click', function(e) {
      e.preventDefault();
      recoverForm.style.display = recoverForm.style.display === 'none' ? 'block' : 'none';
    });
  }
  if (cancelBtn && recoverForm) {
    cancelBtn.addEventListener('click', function(e) {
      e.preventDefault();
      recoverForm.style.display = 'none';
    });
  }
</script>
