<div class="promise-page-body">
  <div class="promise-breadcrumb-wrapper">
    <div class="promise-container">
      <nav class="breadcrumb-nav">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{{ page.title | default: "The SWASTIC EXPORTS Promise" }}</span>
      </nav>
    </div>
  </div>

  <section class="promise-hero-showcase-section">
    <div class="promise-container">
      <div class="promise-banner-card">
        <img src="{{ 'velora-promise.png' | asset_url }}" alt="The SWASTIC EXPORTS Promise" class="promise-banner-img">
      </div>
    </div>
  </section>

  <section class="promise-narrative-section">
    <div class="promise-container narrow">
      <div class="promise-header-block">
        <span class="promise-eyebrow">{{ section.settings.eyebrow | default: "OUR TIMELESS COMMITMENT" }}</span>
        <h1 class="promise-main-title">{{ section.settings.heading | default: "The SWASTIC EXPORTS Promise" }}</h1>
        <p class="promise-lead-statement">
          {{ section.settings.lead | default: "A promise that what you hold is not just rare and beautiful — but rarest, clearest, brightest version of what nature intended." }}
        </p>
      </div>

      <div class="promise-quote-divider">
        <span class="divider-gem">✦</span>
      </div>

      <div class="promise-pillars-grid">
        <div class="pillar-card">
          <div class="pillar-number">01</div>
          <h3 class="pillar-title">100% Natural. Ethical. Trusted.</h3>
          <p class="pillar-body">
            Every single SWASTIC EXPORTS natural gemstone is ethically sourced in accordance with the Kimberley Process certification scheme and United Nations resolutions. Direct-from-mine origins in Zambia, Sri Lanka, and Mozambique.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-number">02</div>
          <h3 class="pillar-title">100% Pure</h3>
          <p class="pillar-body">
            Pure crystalline gemstone treasures created by earth over millions of years. We never sell treated, synthetic-filled, resin-infused, or fracture-filled stones. Authentic mine-to-market provenance.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-number">03</div>
          <h3 class="pillar-title">Integrity of Clarity</h3>
          <p class="pillar-body">
            Every precious gemstone and diamond is independently authenticated and graded by premier international gemological institutions including the Gemological Institute of America (GIA), International Gemological Institute (IGI), and GRS Swisslab.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-number">04</div>
          <h3 class="pillar-title">Crafted Beyond Conviction</h3>
          <p class="pillar-body">
            True luxury is not manufactured; it is sculpted. Backed by over 30 years of master lapidary cutting, faceting, and bespoke goldsmithing since 1994, our master artisans dedicate between 30 to 60 meticulous hours hand-crafting each piece.
          </p>
        </div>
      </div>

      <div class="promise-guarantees-panel">
        <div class="guarantee-item">
          <h4>Lifetime Warranty</h4>
          <p>Complimentary annual prong inspection, prong re-tipping, and rhodium polishing.</p>
        </div>
        <div class="guarantee-item">
          <h4>Free Insured Shipping</h4>
          <p>Discreet luxury delivery via armored express courier, fully insured until signed in hand.</p>
        </div>
        <div class="guarantee-item">
          <h4>30-Day Bespoke Returns</h4>
          <p>Peace of mind guarantee. Exchange or return your piece with 100% full refund.</p>
        </div>
      </div>

      <div class="promise-cta-container">
        <a href="/#diamond-shape-section" class="hero-cta-btn dark-cta">BROWSE HEIRLOOM GEMSTONES</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Swastic Promise Content",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR TIMELESS COMMITMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The SWASTIC EXPORTS Promise"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead Statement",
      "default": "A promise that what you hold is not just rare and beautiful — but rarest, clearest, brightest version of what nature intended."
    }
  ]
}
{% endschema %}
