{% comment %}
  Shopify Section: Site Header & Navigation
  VELORA branding with HOME | RINGS | DIAMONDS | ABOUT
{% endcomment %}

<header class="site-header" id="siteHeader">
  <div class="top-nav-bar">
    <div class="header-left">
      <a href="tel:{{ section.settings.phone | default: '18444000065' }}" class="header-contact-link">
        <svg class="icon phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>{{ section.settings.phone_display | default: '1.844.400.0065' }}</span>
      </a>
      <div class="location-currency">
        <svg class="icon location-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{{ section.settings.country_currency | default: 'USA (USD)' }}</span>
      </div>
    </div>

    <div class="header-logo-container">
      <a href="/" class="brand-logo">
        <span class="logo-title">{{ section.settings.logo_title | default: 'VELORA' }}</span>
        <span class="logo-sub">{{ section.settings.logo_sub | default: 'FINE JEWELRY' }}</span>
      </a>
    </div>

    <div class="header-right">
      <div class="search-pill-container" id="searchTrigger">
        <input type="text" placeholder="Search" id="headerSearchInput" readonly>
        <svg class="icon search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>

      <!-- Wishlist / Favorites Button -->
      <button class="nav-action-btn wishlist-btn" id="wishlistBtn" aria-label="Favorites">
        <svg class="icon heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span class="action-badge" id="wishlistBadgeCount">0</span>
      </button>

      <a href="/account" class="nav-action-btn user-btn" aria-label="Account">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="/cart" class="nav-action-btn cart-btn" id="cartBtn" aria-label="Shopping Bag">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="action-badge" id="cartBadgeCount">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>

  <nav class="main-navigation">
    <ul class="nav-menu">
      <li class="nav-item"><a href="{{ routes.root_url }}" class="nav-link">HOME</a></li>
      <li class="nav-item"><a href="#gemstonesSection" class="nav-link">GEMSTONES</a></li>
      <li class="nav-item"><a href="/pages/promise" class="nav-link">PROMISE</a></li>
      <li class="nav-item"><a href="#storySection" class="nav-link">ABOUT</a></li>
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "text",
      "id": "logo_title",
      "label": "Brand Name",
      "default": "VELORA"
    },
    {
      "type": "text",
      "id": "logo_sub",
      "label": "Brand Tagline",
      "default": "FINE JEWELRY"
    },
    {
      "type": "text",
      "id": "phone_display",
      "label": "Phone Number",
      "default": "1.844.400.0065"
    },
    {
      "type": "text",
      "id": "country_currency",
      "label": "Country & Currency",
      "default": "USA (USD)"
    }
  ]
}
{% endschema %}
