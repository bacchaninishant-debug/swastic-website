{% comment %}
  Shopify Section: Site Footer
  Diamondère style fine jewelry footer
{% endcomment %}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-column brand-col">
      <div class="footer-logo">{{ shop.name | default: 'DIAMONDÈRE' }}</div>
      <p class="footer-tagline">Mastering handcrafted fine jewelry across seven generations since 1890.</p>
      <div class="footer-certifications">
        <span class="cert-badge">GIA CERTIFIED</span>
        <span class="cert-badge">IGI CERTIFIED</span>
        <span class="cert-badge">CONFLICT-FREE</span>
      </div>
    </div>

    <div class="footer-column">
      <h4>FINE JEWELRY</h4>
      <ul>
        <li><a href="#diamond-shape-section">Engagement Rings</a></li>
        <li><a href="#collection-section">Wedding Bands</a></li>
        <li><a href="#collection-section">Eternity Rings</a></li>
        <li><a href="#diamond-shape-section">Lab Grown Diamonds</a></li>
        <li><a href="#collection-section">Men's Wedding Rings</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>SERVICES & POLICIES</h4>
      <ul>
        <li><a href="#">The Swastic Exports Promise</a></li>
        <li><a href="#">Client FAQ & Ordering Guide</a></li>
        <li><a href="#">Bespoke Millimeter Calibration</a></li>
        <li><a href="#">Insured Worldwide Delivery</a></li>
        <li><a href="#">10-Day Returns (Video Req.)</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h4>JAIPUR ATELIER & CONTACT</h4>
      <p class="footer-contact-item"><strong>WhatsApp / Call:</strong> <a href="https://wa.me/919660096877" target="_blank">{{ section.settings.phone | default: '+91 96600 96877' }}</a></p>
      <p class="footer-contact-item"><strong>Email:</strong> <a href="mailto:exhibition.swasticexports@gmail.com">{{ shop.email | default: 'exhibition.swasticexports@gmail.com' }}</a></p>
      <p class="footer-contact-item"><strong>Address:</strong> C-4, 3rd Floor, Swastic House, Gopinath Marg, New Colony, MI Road, Jaipur, Rajasthan</p>
      <p class="footer-tax-info"><strong>GSTIN:</strong> 08AAFFS8734E1Z0</p>
    </div>
  </div>
  
  <div class="footer-bottom-bar">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'SWASTIC EXPORTS (Est. 1980)' }}. All rights reserved. Handcrafted with bespoke precision.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Site Footer",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Support",
      "default": "+91 96600 96877"
    }
  ]
}
{% endschema %}
