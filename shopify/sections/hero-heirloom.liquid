{% comment %}
  Shopify Section: Hero Heirloom Rings
  Screenshot 1: "A Century of Mastery, Handcrafted for you."
{% endcomment %}

<section class="hero-section" id="hero-{{ section.id }}">
  <div class="hero-gems-container">
    <!-- Left Column: Luxury Brand Narrative & Requested Text -->
    <div class="hero-content-col">
      <div class="hero-eyebrow">
        <span class="gold-diamond-icon">✦</span>
        <span class="eyebrow-text">{{ section.settings.eyebrow | default: 'Certified Natural Gemstones' }}</span>
        <span class="gold-diamond-icon">✦</span>
      </div>

      <h1 class="hero-main-title">
        {{ section.settings.heading | default: 'Find Your Perfect<br><span class="hero-title-accent">Gemstone.</span>' }}
      </h1>

      <p class="hero-subtext">
        {{ section.settings.subtext | default: 'Experience the timeless brilliance of authentic, certified natural gems and rare loose diamonds. Hand-selected for exceptional cut, color, and clarity to create your finest bespoke treasures.' }}
      </p>

      <div class="hero-action-group">
        <a href="{{ section.settings.btn_link | default: 'gemstones.html' }}" class="hero-btn-primary">
          {{ section.settings.btn_text | default: 'EXPLORE COLLECTION' }}
        </a>
        <a href="{{ section.settings.secondary_btn_link | default: 'shapes.html' }}" class="hero-btn-secondary">
          {{ section.settings.secondary_btn_text | default: 'SHOP BY SHAPE' }}
        </a>
      </div>

      <div class="hero-trust-badges">
        <div class="trust-badge-item"><span class="badge-dot"></span><span>100% Certified Natural</span></div>
        <div class="trust-badge-item"><span class="badge-dot"></span><span>Master Handcrafted</span></div>
        <div class="trust-badge-item"><span class="badge-dot"></span><span>Conflict-Free</span></div>
      </div>
    </div>

    <!-- Right Column: Swastic Exports House of Gems Visual Showcase with Real Sparkles -->
    <div class="hero-visual-col">
      <div class="hero-image-wrapper">
        {% if section.settings.bg_image != blank %}
          <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | default: 'Swastic Exports - House of Gems' }}" class="hero-gems-img">
        {% else %}
          <img src="{{ 'swastic-gems-hero.png' | asset_url }}" alt="Swastic Exports - House of Gems" class="hero-gems-img">
        {% endif %}

        <!-- Realistic Diamond Sparkles & Light Glints -->
        <div class="diamond-sparkle sparkle-pear-diamond" title="Brilliant Pear Diamond">
          <span class="sparkle-star"><span class="sparkle-star-core"></span></span>
        </div>
        <div class="diamond-sparkle sparkle-emerald-diamond-left" title="Emerald Cut Diamond">
          <span class="sparkle-star"><span class="sparkle-star-core"></span></span>
        </div>
        <div class="diamond-sparkle sparkle-emerald-diamond-right" title="Emerald Cut Diamond">
          <span class="sparkle-star"><span class="sparkle-star-core"></span></span>
        </div>
        <div class="diamond-sparkle sparkle-top-emerald" title="Royal Emerald Cushion">
          <span class="sparkle-glow"></span>
        </div>
        <div class="diamond-sparkle sparkle-ruby-center" title="Burmese Ruby">
          <span class="sparkle-star"><span class="sparkle-star-core"></span></span>
        </div>
        <div class="diamond-sparkle sparkle-sapphire-accent" title="Royal Ceylon Sapphire">
          <span class="sparkle-star"><span class="sparkle-star-core"></span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator">
    <a href="#collection-section" aria-label="Scroll down">
      <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="7 13 12 18 17 13"></polyline>
        <polyline points="7 6 12 11 17 6"></polyline>
      </svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero Heirloom Rings",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "A Century of Mastery,<br>Handcrafted for you."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "SHOP HEIRLOOM RINGS"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Heirloom Rings"
    }
  ]
}
{% endschema %}
