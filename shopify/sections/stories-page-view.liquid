<section class="reviews-page-view-section" id="stories-page-view">
  <div class="promise-container" style="max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px;">
    
    <!-- Top Title & Breadcrumb matching Customer Reviews -->
    <div style="margin-bottom: 30px;">
      <h1 style="font-size: 26px; font-weight: 600; color: #111827; margin-bottom: 6px; font-family: var(--font-sans);">Customer Reviews</h1>
      <div style="font-size: 13px; color: #94a3b8; font-family: var(--font-sans);">
        <a href="#heroSection" onclick="return window.showPageView ? window.showPageView('home', event) : true;" style="color: #94a3b8; text-decoration: none;">Home</a> / <span style="color: #64748b;">Reviews</span>
      </div>
    </div>

    <!-- 2-Column Reviews Layout matching Image 1 -->
    <div class="customer-reviews-layout" style="display: flex; gap: 40px; padding: 0;">
      
      <!-- Left: Overall Rating & Breakdown -->
      <aside class="customer-reviews-sidebar">
        <div class="sidebar-score-num">4.9</div>
        <div class="sidebar-stars">
          <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        </div>
        <div class="sidebar-count-label">1,966 reviews</div>

        <div class="rating-breakdown-list">
          <!-- 5 Stars -->
          <div class="breakdown-row">
            <span class="star-level">5</span>
            <div class="bar-track-wrap">
              <div class="bar-track-fill" style="width: 95.4%;"></div>
            </div>
            <span class="count-val">1876</span>
          </div>

          <!-- 4 Stars -->
          <div class="breakdown-row">
            <span class="star-level">4</span>
            <div class="bar-track-wrap">
              <div class="bar-track-fill" style="width: 3.6%;"></div>
            </div>
            <span class="count-val">70</span>
          </div>

          <!-- 3 Stars -->
          <div class="breakdown-row">
            <span class="star-level">3</span>
            <div class="bar-track-wrap">
              <div class="bar-track-fill" style="width: 0.7%;"></div>
            </div>
            <span class="count-val">14</span>
          </div>

          <!-- 2 Stars -->
          <div class="breakdown-row">
            <span class="star-level">2</span>
            <div class="bar-track-wrap">
              <div class="bar-track-fill" style="width: 0.2%;"></div>
            </div>
            <span class="count-val">3</span>
          </div>

          <!-- 1 Star -->
          <div class="breakdown-row">
            <span class="star-level">1</span>
            <div class="bar-track-wrap">
              <div class="bar-track-fill" style="width: 0.2%;"></div>
            </div>
            <span class="count-val">3</span>
          </div>
        </div>
      </aside>

      <!-- Right: Reviews Feed -->
      <main class="customer-reviews-feed" id="customerReviewsFeed" style="flex: 1;">
        <!-- Category Filter Bar -->
        <div class="reviews-filter-bar" id="reviewsFilterBar">
          <button type="button" class="review-filter-chip active" data-filter="all">All Reviews (1,966)</button>
          <button type="button" class="review-filter-chip" data-filter="emeralds">Zambian Emeralds (620)</button>
          <button type="button" class="review-filter-chip" data-filter="sapphires">Ceylon Sapphires (540)</button>
          <button type="button" class="review-filter-chip" data-filter="rubies">Burmese Rubies (310)</button>
          <button type="button" class="review-filter-chip" data-filter="fancy">Precious Gems (496)</button>
        </div>

        <!-- Review 1: Evelyne Baum -->
        <article class="review-item-row" data-category="fancy">
          <div class="review-avatar-circle">EB</div>
          <div class="review-item-content">
            <div class="review-item-meta">
              <span class="review-buyer-name">Evelyne Baum</span>
              <span class="review-verified-badge">Verified buyer</span>
              <span class="review-item-date">• Sep 23, 2026</span>
            </div>
            <div class="review-item-stars">
              <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
