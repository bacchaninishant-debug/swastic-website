{% comment %}
  Shopify Section: Four Collections Grid
  Screenshot 2: Eternity Bands, Black Gold Men's, Vintage, Emerald Bracelets
{% endcomment %}

<section class="featured-collections-section" id="collections-{{ section.id }}">
  <div class="collections-container">
    {% for block in section.blocks %}
      <div class="collection-card" {{ block.shopify_attributes }}>
        <div class="collection-img-wrapper">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}">
          {% else %}
            <img src="{{ block.settings.default_asset | asset_url }}" alt="{{ block.settings.title }}">
          {% endif %}
        </div>
        <h3 class="collection-title">{{ block.settings.title }}</h3>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections Grid",
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title",
          "default": "Eternity Band Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "default_asset",
          "label": "Default Asset Filename",
          "default": "collection-eternity.jpg"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections Grid"
    }
  ]
}
{% endschema %}
